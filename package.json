{
  "name": "stream-sorting",
  "version": "0.0.0",
  "description": "External merge sort and sorted-stream operations (mergeJoin, union, intersection, difference) for object-mode Node Readable streams. Part of the stream-chain / stream-json / stream-join family.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./*": "./src/*"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tape6 --flags FO",
    "test:bun": "tape6-bun --flags FO",
    "test:deno": "tape6-deno --flags FO",
    "ts-check": "tsc --noEmit",
    "js-check": "tsc --project tsconfig.check.json",
    "ts-test": "tape6 --flags FO 'tests/test-*.ts'",
    "ts-test:bun": "tape6-bun --flags FO 'tests/test-*.ts'",
    "ts-test:deno": "tape6-deno --flags FO 'tests/test-*.ts'",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uhop/stream-sorting.git"
  },
  "keywords": [
    "stream",
    "streaming",
    "sort",
    "external-merge-sort",
    "merge-join",
    "set-operations",
    "union",
    "intersection",
    "difference",
    "object-mode",
    "backpressure"
  ],
  "author": "Eugene Lazutkin <eugene.lazutkin@gmail.com> (https://www.lazutkin.com/)",
  "funding": "https://github.com/sponsors/uhop",
  "llms": "https://raw.githubusercontent.com/uhop/stream-sorting/main/llms.txt",
  "llmsFull": "https://raw.githubusercontent.com/uhop/stream-sorting/main/llms-full.txt",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/uhop/stream-sorting/issues"
  },
  "homepage": "https://github.com/uhop/stream-sorting#readme",
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "tape6": {
    "tests": [
      "/tests/test-*.js"
    ]
  },
  "dependencies": {
    "stream-chain": "^4.0.2",
    "stream-join": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "^3.8.3",
    "tape-six": "^1.9.0",
    "typescript": "^6.0.3"
  }
}
